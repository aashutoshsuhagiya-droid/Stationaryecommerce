# Replace these before enabling live services.
# Use the direct, unpooled endpoint for Prisma CLI migrations, schema changes, and bootstrap scripts.
DATABASE_URL="postgresql://user:password@your-neon-endpoint.c-6.us-east-2.aws.neon.tech/naamly?sslmode=require"
# Use Neon's PgBouncer endpoint for Next.js serverless runtime queries.
# The application falls back to DATABASE_URL only when this value is not configured.
DATABASE_URL_POOLED="postgresql://user:password@your-neon-endpoint-pooler.c-6.us-east-2.aws.neon.tech/naamly?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
VENDOR_OTP_SECRET="replace-with-a-separate-long-random-secret"
# Optional HTTPS endpoint that accepts { phone, code, purpose } for SMS delivery.
VENDOR_OTP_PROVIDER_URL=""
VENDOR_OTP_PROVIDER_TOKEN=""
VENDOR_OFFER_WINDOW_SECONDS="60"
VENDOR_MAX_OFFERS_PER_ORDER="10"
VENDOR_RETRY_DELAY_SECONDS="60"
ASSIGNMENT_RECOVERY_SECRET="replace-with-a-long-random-cron-secret"
# Set these only while running `npm.cmd run db:bootstrap-admin`, then remove them.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_FIRST_NAME=""
BOOTSTRAP_ADMIN_LAST_NAME=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
DEMO_PAYMENT_SECRET="replace-for-local-payment-signature-tests"
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
NEXT_PUBLIC_INSTAGRAM_URL=""
BULK_QUOTE_MIN_QUANTITY="1"
BULK_QUOTE_MAX_QUANTITY="100000"
# Optional server-side image analysis integration for the admin visualization studio.
# Leave both blank to use the default guided manual-confirmation workflow.
# Production endpoints must use HTTPS; never expose the API key through NEXT_PUBLIC_* variables.
IMAGE_TO_3D_ANALYSIS_ENDPOINT=""
IMAGE_TO_3D_ANALYSIS_API_KEY=""
