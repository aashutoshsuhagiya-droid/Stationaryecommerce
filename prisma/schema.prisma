generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryPolicy {
  DENY
  CONTINUE
  MADE_TO_ORDER
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ArtworkStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  GENERATED
  FAILED
}

enum ArtworkAssetStatus {
  UPLOADED
  ATTACHED
  APPROVED
  REJECTED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  ORDER_RECEIVED
  PAYMENT_CONFIRMED
  CUSTOMIZATION_REVIEW
  PRODUCTION_APPROVED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_PROCESSING
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
  COD
  MANUAL
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}

enum CouponType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BulkRequestStatus {
  DRAFT
  SUBMITTED
  VALIDATING
  NEEDS_CHANGES
  QUOTED
  ACCEPTED
  CONVERTED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

enum VendorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VendorOperationalStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VendorDocumentType {
  BUSINESS_REGISTRATION
  GST_CERTIFICATE
  SHOP_LICENSE
  IDENTITY_PROOF
  ADDRESS_PROOF
  OTHER
}

enum VendorDocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorAvailabilityStatus {
  OFFLINE
  ONLINE
  PAUSED
}

enum OrderAssignmentStatus {
  PENDING
  OFFERED
  ASSIGNED
  UNASSIGNED
  EXPIRED
  CANCELLED
}

enum VendorOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CLOSED
}

enum AssignmentEventType {
  ASSIGNMENT_STARTED
  OFFERS_CREATED
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_EXPIRED
  COMPETING_OFFERS_CLOSED
  NO_ELIGIBLE_VENDOR
  ASSIGNMENT_EXPIRED
  ASSIGNMENT_CANCELLED
  REASSIGNED
}

model User {
  id                         String                       @id @default(cuid())
  email                      String                       @unique @db.VarChar(254)
  phone                      String?                      @unique @db.VarChar(20)
  passwordHash               String?                      @db.VarChar(255)
  firstName                  String?                      @db.VarChar(80)
  lastName                   String?                      @db.VarChar(80)
  status                     UserStatus                   @default(ACTIVE)
  emailVerifiedAt            DateTime?
  phoneVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  deletedAt                  DateTime?
  addresses                  Address[]
  roles                      UserRole[]
  carts                      Cart[]
  orders                     Order[]
  customizations             CustomizationConfiguration[]
  reviews                    Review[]
  wishlists                  Wishlist[]
  couponRedemptions          CouponRedemption[]
  bulkRequests               BulkOrderRequest[]
  supportTickets             SupportTicket[]
  supportMessages            SupportMessage[]
  notifications              Notification[]
  auditLogs                  AuditLog[]                   @relation("AuditActor")
  vendorProfile              VendorProfile?
  vendorApplication          VendorApplication?
  authSessions               AuthSession[]
  reviewedVendorApplications VendorApplication[]          @relation("VendorApplicationReviewer")
  vendorApplicationEvents    VendorApplicationEvent[]     @relation("VendorApplicationActor")
  uploadedVendorDocuments    VendorDocument[]             @relation("VendorDocumentUploader")
  reviewedVendorDocuments    VendorDocument[]             @relation("VendorDocumentReviewer")
  uploadedArtworkAssets      ArtworkAsset[]                @relation("ArtworkAssetOwner")

  @@index([status, createdAt])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PhoneVerificationChallenge {
  id         String    @id @default(cuid())
  phone      String    @db.VarChar(20)
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt, consumedAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(60)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(300)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(300)
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  type         AddressType @default(HOME)
  label        String?     @db.VarChar(60)
  fullName     String      @db.VarChar(100)
  phone        String      @db.VarChar(20)
  addressLine1 String      @db.VarChar(160)
  addressLine2 String?     @db.VarChar(160)
  landmark     String?     @db.VarChar(100)
  city         String      @db.VarChar(80)
  state        String      @db.VarChar(80)
  postalCode   String      @db.VarChar(10)
  countryCode  String      @default("IN") @db.Char(2)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([postalCode])
}

model Category {
  id             String                    @id @default(cuid())
  parentId       String?
  name           String                    @db.VarChar(120)
  slug           String                    @unique @db.VarChar(140)
  description    String?
  imageUrl       String?
  seoTitle       String?                   @db.VarChar(160)
  seoDescription String?                   @db.VarChar(320)
  sortOrder      Int                       @default(0)
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  parent         Category?                 @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]                @relation("CategoryTree")
  products       Product[]
  productLinks   ProductCategory[]
  templates      PersonalizationTemplate[]
  couponLinks    CouponCategory[]

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
}

model Product {
  id                    String                        @id @default(cuid())
  categoryId            String
  name                  String                        @db.VarChar(180)
  slug                  String                        @unique @db.VarChar(200)
  baseSku               String                        @unique @db.VarChar(80)
  status                ProductStatus                 @default(DRAFT)
  shortDescription      String?                       @db.VarChar(400)
  description           String?
  basePricePaise        Int
  compareAtPricePaise   Int?
  currency              String                        @default("INR") @db.Char(3)
  customizable          Boolean                       @default(false)
  material              String?                       @db.VarChar(160)
  dimensions            Json?
  weightGrams           Int?
  packSize              Int                           @default(1)
  taxCode               String?                       @db.VarChar(30)
  taxRateBasisPoints    Int                           @default(0)
  productionDaysMin     Int                           @default(0)
  productionDaysMax     Int                           @default(0)
  seoTitle              String?                       @db.VarChar(160)
  seoDescription        String?                       @db.VarChar(320)
  tags                  String[]
  metadata              Json?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  category              Category                      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryLinks         ProductCategory[]
  variants              ProductVariant[]
  images                ProductImage[]
  personalizationFields ProductPersonalizationField[]
  templateLinks         ProductTemplate[]
  customizations        CustomizationConfiguration[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  couponLinks           CouponProduct[]
  bulkRequests          BulkOrderRequest[]
  vendorCapabilities    VendorCapability[]
  artworkAssets         ArtworkAsset[]

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([basePricePaise])
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ArtworkAsset {
  id              String             @id @default(cuid())
  productId       String
  orderItemId     String?
  ownerUserId     String?
  surfaceId       String             @db.VarChar(80)
  claimTokenHash  String             @unique @db.Char(64)
  originalName    String             @db.VarChar(200)
  mimeType        String             @db.VarChar(100)
  sizeBytes       Int
  width           Int
  height          Int
  hasTransparency Boolean            @default(false)
  sha256          String             @db.Char(64)
  content         Bytes
  status          ArtworkAssetStatus @default(UPLOADED)
  expiresAt       DateTime
  attachedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem       OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  owner           User?              @relation("ArtworkAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([productId, surfaceId, status])
  @@index([orderItemId])
  @@index([ownerUserId, createdAt])
  @@index([status, expiresAt])
  @@index([sha256])
}

model ProductVariant {
  id                  String              @id @default(cuid())
  productId           String
  sku                 String              @unique @db.VarChar(80)
  name                String              @db.VarChar(160)
  optionValues        Json
  pricePaise          Int
  compareAtPricePaise Int?
  costPaise           Int?
  currency            String              @default("INR") @db.Char(3)
  weightGrams         Int?
  inventoryPolicy     InventoryPolicy     @default(DENY)
  isActive            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory           Inventory?
  inventoryMovements  InventoryMovement[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([productId, isActive, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String   @db.VarChar(240)
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
}

model ProductPersonalizationField {
  id              String   @id @default(cuid())
  productId       String
  key             String   @db.VarChar(80)
  label           String   @db.VarChar(120)
  inputType       String   @db.VarChar(40)
  isRequired      Boolean  @default(false)
  minLength       Int?
  maxLength       Int?
  validation      Json?
  optionConfig    Json?
  priceDeltaPaise Int      @default(0)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId, sortOrder])
}

model PersonalizationTemplate {
  id                    String                       @id @default(cuid())
  categoryId            String?
  name                  String                       @db.VarChar(140)
  slug                  String                       @unique @db.VarChar(160)
  theme                 String?                      @db.VarChar(100)
  status                TemplateStatus               @default(DRAFT)
  description           String?
  thumbnailUrl          String?
  previewConfig         Json
  productionConfig      Json
  productionWidthPx     Int
  productionHeightPx    Int
  productionDpi         Int
  premiumPricePaise     Int                          @default(0)
  rightsReference       String?                      @db.VarChar(300)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  category              Category?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productLinks          ProductTemplate[]
  customizations        CustomizationConfiguration[]
  orderPersonalizations OrderPersonalization[]

  @@index([categoryId, status])
  @@index([status, theme])
}

model ProductTemplate {
  productId  String
  templateId String
  sortOrder  Int                     @default(0)
  isDefault  Boolean                 @default(false)
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  template   PersonalizationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([productId, templateId])
  @@index([templateId])
}

model Inventory {
  id               String         @id @default(cuid())
  variantId        String         @unique
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  reorderPoint     Int            @default(0)
  updatedAt        DateTime       @updatedAt
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id            String                @id @default(cuid())
  variantId     String
  type          InventoryMovementType
  quantity      Int
  referenceType String?               @db.VarChar(60)
  referenceId   String?               @db.VarChar(100)
  note          String?               @db.VarChar(400)
  createdAt     DateTime              @default(now())
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
}

model CustomizationConfiguration {
  id                 String                   @id @default(cuid())
  userId             String?
  productId          String
  templateId         String?
  values             Json
  previewVersion     Int                      @default(1)
  previewAssetUrl    String?
  productionAssetUrl String?
  artworkStatus      ArtworkStatus            @default(DRAFT)
  checksum           String?                  @db.VarChar(128)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  template           PersonalizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  cartItem           CartItem?

  @@index([userId, updatedAt])
  @@index([productId, templateId])
  @@index([artworkStatus])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  guestTokenHash String?    @unique @db.VarChar(128)
  status         CartStatus @default(ACTIVE)
  currency       String     @default("INR") @db.Char(3)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@index([expiresAt])
}

model CartItem {
  id              String                      @id @default(cuid())
  cartId          String
  productId       String
  variantId       String
  customizationId String?                     @unique
  quantity        Int
  unitPricePaise  Int
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  cart            Cart                        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customization   CustomizationConfiguration? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId, variantId])
}

model Order {
  id                     String             @id @default(cuid())
  orderNumber            String             @unique @db.VarChar(40)
  userId                 String?
  customerEmail          String             @db.VarChar(254)
  customerPhone          String             @db.VarChar(20)
  status                 OrderStatus        @default(ORDER_RECEIVED)
  paymentStatus          PaymentStatus      @default(PENDING)
  currency               String             @default("INR") @db.Char(3)
  subtotalPaise          Int
  shippingPaise          Int                @default(0)
  taxPaise               Int                @default(0)
  discountPaise          Int                @default(0)
  totalPaise             Int
  couponCodeSnapshot     String?            @db.VarChar(40)
  shippingMethodSnapshot Json?
  customerNotes          String?            @db.VarChar(500)
  internalNotes          String?
  idempotencyKey         String             @unique @db.VarChar(128)
  placedAt               DateTime           @default(now())
  cancelledAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses              OrderAddress[]
  items                  OrderItem[]
  payments               Payment[]
  shipments              Shipment[]
  couponRedemptions      CouponRedemption[]
  supportTickets         SupportTicket[]
  assignment             OrderAssignment?
  assignmentEvents       AssignmentEvent[]

  @@index([userId, placedAt])
  @@index([customerEmail, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus, placedAt])
}

model VendorProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  applicationId       String                   @unique
  businessName        String                   @db.VarChar(180)
  ownerName           String                   @db.VarChar(120)
  businessPhone       String                   @db.VarChar(20)
  addressLine1        String                   @db.VarChar(160)
  addressLine2        String?                  @db.VarChar(160)
  city                String                   @db.VarChar(80)
  normalizedCity      String                   @db.VarChar(80)
  state               String                   @db.VarChar(80)
  postalCode          String                   @db.VarChar(10)
  servicePostalCodes  String[]
  serviceCategoryIds  String[]                 @default([])
  verificationStatus  VendorVerificationStatus @default(PENDING)
  operationalStatus   VendorOperationalStatus  @default(INACTIVE)
  availabilityStatus  VendorAvailabilityStatus @default(OFFLINE)
  maxConcurrentOrders Int                      @default(1)
  activeOrderCount    Int                      @default(0)
  acceptingOrders     Boolean                  @default(false)
  verificationNotes   String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  suspendedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  application         VendorApplication        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  capabilities        VendorCapability[]
  offers              VendorOrderOffer[]
  assignments         OrderAssignment[]        @relation("AssignedVendor")
  assignmentEvents    AssignmentEvent[]

  @@index([verificationStatus, operationalStatus, availabilityStatus, acceptingOrders])
  @@index([normalizedCity, verificationStatus, availabilityStatus])
  @@index([postalCode])
  @@index([serviceCategoryIds(ops: ArrayOps)], type: Gin, map: "VendorProfile_serviceCategoryIds_gin_idx")
}

model VendorApplication {
  id                         String                   @id @default(cuid())
  userId                     String                   @unique
  status                     VendorApplicationStatus  @default(DRAFT)
  version                    Int                      @default(1)
  ownerName                  String                   @db.VarChar(120)
  businessName               String                   @db.VarChar(180)
  businessEmail              String                   @db.VarChar(254)
  businessPhone              String                   @db.VarChar(20)
  addressLine1               String                   @db.VarChar(160)
  addressLine2               String?                  @db.VarChar(160)
  city                       String                   @db.VarChar(80)
  normalizedCity             String                   @db.VarChar(80)
  state                      String                   @db.VarChar(80)
  postalCode                 String                   @db.VarChar(10)
  latitude                   Decimal?                 @db.Decimal(9, 6)
  longitude                  Decimal?                 @db.Decimal(9, 6)
  servicePostalCodes         String[]
  serviceCategoryIds         String[]
  printingServices           String[]
  equipment                  String[]
  businessRegistrationNumber String?                  @db.VarChar(80)
  gstin                      String?                  @db.VarChar(15)
  termsVersion               String                   @db.VarChar(40)
  privacyVersion             String                   @db.VarChar(40)
  termsAcceptedAt            DateTime
  submittedAt                DateTime?
  reviewStartedAt            DateTime?
  reviewedAt                 DateTime?
  reviewerId                 String?
  applicantMessage           String?                  @db.VarChar(1000)
  internalReviewNotes        String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewer                   User?                    @relation("VendorApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  profile                    VendorProfile?
  documents                  VendorDocument[]
  events                     VendorApplicationEvent[]

  @@index([status, submittedAt])
  @@index([normalizedCity, status])
  @@index([reviewerId, status])
}

model VendorDocument {
  id            String                     @id @default(cuid())
  applicationId String
  uploadedById  String
  reviewedById  String?
  type          VendorDocumentType
  reviewStatus  VendorDocumentReviewStatus @default(PENDING)
  originalName  String                     @db.VarChar(200)
  mimeType      String                     @db.VarChar(100)
  sizeBytes     Int
  sha256        String                     @db.Char(64)
  content       Bytes
  reviewNotes   String?                    @db.VarChar(500)
  reviewedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  application   VendorApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy    User                       @relation("VendorDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy    User?                      @relation("VendorDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId, type, reviewStatus])
  @@index([sha256])
}

model VendorApplicationEvent {
  id               String                   @id @default(cuid())
  applicationId    String
  actorId          String?
  fromStatus       VendorApplicationStatus?
  toStatus         VendorApplicationStatus
  action           String                   @db.VarChar(80)
  applicantMessage String?                  @db.VarChar(1000)
  internalNotes    String?
  requestId        String?                  @db.VarChar(120)
  createdAt        DateTime                 @default(now())
  application      VendorApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor            User?                    @relation("VendorApplicationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
  @@index([toStatus, createdAt])
}

model VendorCapability {
  id               String        @id @default(cuid())
  vendorId         String
  productId        String
  isActive         Boolean       @default(true)
  maxOrderQuantity Int?
  productionDays   Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  vendor           VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productId])
  @@index([productId, isActive])
  @@index([vendorId, isActive])
}

model OrderAssignment {
  id               String                @id @default(cuid())
  orderId          String                @unique
  status           OrderAssignmentStatus @default(PENDING)
  attempt          Int                   @default(1)
  assignedVendorId String?
  offerExpiresAt   DateTime?
  assignedAt       DateTime?
  failureReason    String?               @db.VarChar(300)
  version          Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedVendor   VendorProfile?        @relation("AssignedVendor", fields: [assignedVendorId], references: [id], onDelete: Restrict)
  offers           VendorOrderOffer[]
  events           AssignmentEvent[]

  @@index([status, offerExpiresAt])
  @@index([assignedVendorId, status])
}

model VendorOrderOffer {
  id              String            @id @default(cuid())
  assignmentId    String
  vendorId        String
  status          VendorOfferStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  closedAt        DateTime?
  rejectionReason String?           @db.VarChar(300)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  assignment      OrderAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendor          VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, vendorId])
  @@index([vendorId, status, expiresAt])
  @@index([assignmentId, status])
  @@index([status, expiresAt])
}

model AssignmentEvent {
  id           String              @id @default(cuid())
  assignmentId String
  orderId      String
  vendorId     String?
  type         AssignmentEventType
  metadata     Json?
  createdAt    DateTime            @default(now())
  assignment   OrderAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor       VendorProfile?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([assignmentId, createdAt])
  @@index([orderId, createdAt])
  @@index([vendorId, createdAt])
  @@index([type, createdAt])
}

model OrderAddress {
  id           String           @id @default(cuid())
  orderId      String
  type         OrderAddressType
  fullName     String           @db.VarChar(100)
  phone        String           @db.VarChar(20)
  addressLine1 String           @db.VarChar(160)
  addressLine2 String?          @db.VarChar(160)
  landmark     String?          @db.VarChar(100)
  city         String           @db.VarChar(80)
  state        String           @db.VarChar(80)
  postalCode   String           @db.VarChar(10)
  countryCode  String           @default("IN") @db.Char(2)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([postalCode])
}

model OrderItem {
  id                  String                @id @default(cuid())
  orderId             String
  productId           String?
  variantId           String?
  productNameSnapshot String                @db.VarChar(180)
  productSlugSnapshot String                @db.VarChar(200)
  skuSnapshot         String                @db.VarChar(80)
  variantSnapshot     Json
  productSnapshot     Json
  quantity            Int
  unitPricePaise      Int
  discountPaise       Int                   @default(0)
  taxPaise            Int                   @default(0)
  lineTotalPaise      Int
  createdAt           DateTime              @default(now())
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  personalization     OrderPersonalization?
  productionJob       ProductionJob?
  review              Review?
  artworkAssets       ArtworkAsset[]

  @@index([orderId])
  @@index([productId])
  @@index([skuSnapshot])
}

model OrderPersonalization {
  id                 String                   @id @default(cuid())
  orderItemId        String                   @unique
  templateId         String?
  templateSnapshot   Json?
  values             Json
  previewVersion     Int
  previewAssetUrl    String?
  productionAssetUrl String?
  artworkStatus      ArtworkStatus            @default(PENDING_REVIEW)
  approvedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  orderItem          OrderItem                @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  template           PersonalizationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([artworkStatus, createdAt])
}

model ProductionJob {
  id              String      @id @default(cuid())
  orderItemId     String      @unique
  status          OrderStatus @default(CUSTOMIZATION_REVIEW)
  assignedToId    String?
  productionNotes String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([assignedToId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  status            PaymentStatus   @default(CREATED)
  amountPaise       Int
  currency          String          @default("INR") @db.Char(3)
  providerOrderId   String?         @unique @db.VarChar(120)
  providerPaymentId String?         @unique @db.VarChar(120)
  idempotencyKey    String          @unique @db.VarChar(128)
  methodSnapshot    Json?
  failureCode       String?         @db.VarChar(100)
  failureMessage    String?         @db.VarChar(400)
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]
  refunds           Refund[]

  @@index([orderId, createdAt])
  @@index([provider, status])
}

model PaymentEvent {
  id              String          @id @default(cuid())
  paymentId       String?
  provider        PaymentProvider
  providerEventId String          @unique @db.VarChar(140)
  eventType       String          @db.VarChar(100)
  signatureValid  Boolean
  payload         Json
  processedAt     DateTime?
  processingError String?
  receivedAt      DateTime        @default(now())
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, receivedAt])
  @@index([processedAt, receivedAt])
}

model Refund {
  id               String        @id @default(cuid())
  paymentId        String
  providerRefundId String?       @unique @db.VarChar(120)
  amountPaise      Int
  reason           String?       @db.VarChar(400)
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String
  provider            String?        @db.VarChar(80)
  providerShipmentId  String?        @unique @db.VarChar(120)
  trackingNumber      String?        @unique @db.VarChar(120)
  trackingUrl         String?
  status              ShipmentStatus @default(PENDING)
  shippingMethod      String?        @db.VarChar(100)
  shippingChargePaise Int            @default(0)
  estimatedDispatchAt DateTime?
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([status, updatedAt])
}

model Coupon {
  id                   String             @id @default(cuid())
  code                 String             @unique @db.VarChar(40)
  description          String?            @db.VarChar(300)
  type                 CouponType
  value                Int
  minimumSubtotalPaise Int?
  maximumDiscountPaise Int?
  usageLimit           Int?
  usageLimitPerUser    Int?
  stackable            Boolean            @default(false)
  startsAt             DateTime
  endsAt               DateTime?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  productLinks         CouponProduct[]
  categoryLinks        CouponCategory[]
  redemptions          CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponRedemption {
  id                  String   @id @default(cuid())
  couponId            String
  userId              String?
  orderId             String
  discountAmountPaise Int
  redeemedAt          DateTime @default(now())
  coupon              Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([userId, couponId])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String?
  orderItemId      String?      @unique
  status           ReviewStatus @default(PENDING)
  rating           Int
  title            String?      @db.VarChar(140)
  body             String       @db.VarChar(2000)
  displayName      String       @db.VarChar(100)
  verifiedPurchase Boolean      @default(false)
  photoUrls        String[]
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  name      String         @default("My wishlist") @db.VarChar(100)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@unique([userId, name])
}

model WishlistItem {
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
}

model BulkOrderRequest {
  id               String            @id @default(cuid())
  requestNumber    String            @unique @db.VarChar(40)
  userId           String?
  productId        String?
  status           BulkRequestStatus @default(DRAFT)
  organizationName String            @db.VarChar(160)
  contactName      String            @db.VarChar(100)
  email            String            @db.VarChar(254)
  phone            String            @db.VarChar(20)
  expectedQuantity Int
  sourceFileUrl    String?
  validationReport Json?
  quotePaise       Int?
  notes            String?
  submittedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  rows             BulkOrderRow[]

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model BulkOrderRow {
  id               String           @id @default(cuid())
  bulkRequestId    String
  rowNumber        Int
  personalization  Json
  quantity         Int
  isValid          Boolean          @default(false)
  validationErrors Json?
  previewAssetUrl  String?
  bulkRequest      BulkOrderRequest @relation(fields: [bulkRequestId], references: [id], onDelete: Cascade)

  @@unique([bulkRequestId, rowNumber])
  @@index([bulkRequestId, isValid])
}

model SupportTicket {
  id           String           @id @default(cuid())
  ticketNumber String           @unique @db.VarChar(40)
  userId       String?
  orderId      String?
  email        String           @db.VarChar(254)
  subject      String           @db.VarChar(180)
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(NORMAL)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([orderId])
}

model SupportMessage {
  id             String        @id @default(cuid())
  ticketId       String
  authorId       String?
  body           String
  internal       Boolean       @default(false)
  attachmentUrls String[]
  createdAt      DateTime      @default(now())
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String?
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  templateKey       String              @db.VarChar(100)
  recipient         String              @db.VarChar(254)
  payload           Json
  providerMessageId String?             @unique @db.VarChar(160)
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureMessage    String?             @db.VarChar(400)
  createdAt         DateTime            @default(now())
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(120)
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  requestId  String?  @db.VarChar(120)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(120)
  value       Json
  description String?  @db.VarChar(300)
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  message   String    @db.VarChar(240)
  href      String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(240)
  answer    String
  category  String?  @db.VarChar(80)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, category, sortOrder])
}
