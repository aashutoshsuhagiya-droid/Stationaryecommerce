{
  "name": "naamly-storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "npm run test:domain",
    "test:domain": "tsx --conditions=react-server --test src/lib/*.test.ts src/components/configurator/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.prisma.json",
    "import:external-catalog": "tsx scripts/import-external-catalog/import.ts",
    "import:external-catalog:fidelity": "tsx scripts/import-external-catalog/import-fidelity.ts",
    "import:external-catalog:dry-run": "tsx scripts/import-external-catalog/import-fidelity.ts --dry-run",
    "import:external-catalog:offline": "tsx scripts/import-external-catalog/import-fidelity.ts --offline",
    "import:external-catalog:3d": "tsx --conditions=react-server scripts/import-external-catalog/3d-enable.ts",
    "import:external-catalog:publish": "tsx scripts/import-external-catalog/publish-imported.ts",
    "import:external-catalog:ezpac-quotation": "tsx --conditions=react-server scripts/import-external-catalog/ezpac-quotation.ts",
    "test:external-catalog": "tsx --test scripts/import-external-catalog/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && tsx prisma/install-marketplace-runtime.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/install-marketplace-runtime.ts && tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/pg": "8.15.5",
    "@types/three": "^0.186.0",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "^16.4.6",
    "pg": "8.16.3",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "7.10.1",
    "puppeteer-core": "^25.16.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
