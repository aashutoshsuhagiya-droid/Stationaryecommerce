{
  "name": "naamly-storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "test:domain": "tsx --test src/lib/*.test.ts src/components/configurator/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.prisma.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && tsx prisma/install-marketplace-runtime.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/install-marketplace-runtime.ts && tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/pg": "8.15.5",
    "@types/three": "^0.186.0",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "8.16.3",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "7.10.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
